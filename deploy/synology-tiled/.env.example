# Use absolute Synology paths. Create these directories before deployment.
TILED_DATA_ROOT=/volume1/docker/afl-tiled
TILED_SECRET_FILE=/volume1/docker/afl-tiled-secrets/tiled_api_key

# UID/GID of a dedicated, non-admin Synology service account that owns the
# catalog and data directories. Find these with: id afl-tiled
TILED_UID=REPLACE_ME
TILED_GID=REPLACE_ME

# Keep 127.0.0.1 when using Synology Reverse Proxy. For direct access from a
# protected lab LAN, use the NAS's fixed LAN address, never 0.0.0.0.
TILED_BIND_ADDRESS=127.0.0.1
TILED_PORT=8000
